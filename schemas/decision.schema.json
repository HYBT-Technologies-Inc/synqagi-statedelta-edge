{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://synqagi.example/schemas/decision.schema.json",
  "title": "SYNQAGI StateDelta Decision",
  "type": "object",
  "required": [
    "decision_version",
    "capsule_id",
    "conformance",
    "state",
    "severity",
    "delta",
    "evidence",
    "recommended_action",
    "confidence",
    "uncertainty",
    "requires_human_review"
  ],
  "properties": {
    "decision_version": {"type": "string"},
    "capsule_id": {"type": "string"},
    "conformance": {"enum": ["PASS", "PASS_WITH_WARNING", "INSUFFICIENT_EVIDENCE", "FAIL", "CRITICAL_FAIL"]},
    "state": {"enum": ["NORMAL", "CHANGED", "DEGRADING", "OUT_OF_TOLERANCE", "UNSAFE", "UNKNOWN"]},
    "severity": {"enum": ["NONE", "LOW", "MEDIUM", "HIGH", "CRITICAL"]},
    "delta": {"type": "array"},
    "evidence": {"type": "array"},
    "recommended_action": {"type": "string"},
    "validated_action": {"type": "string"},
    "confidence": {"type": "number", "minimum": 0, "maximum": 1},
    "uncertainty": {"type": "array"},
    "requires_human_review": {"type": "boolean"}
  },
  "additionalProperties": true
}
